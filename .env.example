# =================================================================
# CONFIGURAÇÕES DO AMBIENTE (EXEMPLO)
# Copie este arquivo para .env e preencha as suas credenciais
# =================================================================

# 1. BANCO DE DADOS & NUVEM (Supabase / Postgres)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_service_role_secret_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret_aqui
SUPABASE_USER_ID=seu_user_id_uuid

# 2. MOTOR DE INTELlGÊNCIA ARTIFICIAL (Google Gemini API - Gratuito)
GEMINI_API_KEY=sua_chave_do_google_ai_studio

# 3. NUXT 3 DASHBOARD (Configurações do Frontend)
NUXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_do_supabase

# 4. SERVIDOR DE SCRAPING NA NUVEM (Opcional - Webhook GCP / Cloud Run)
GCP_CLOUD_RUN_URL=https://seu-servico-cloud-run.a.run.app

# 5. INTEGRAÇÕES GITHUB (Opcional - GitHub Actions)
GITHUB_PAT=seu_personal_access_token_github
